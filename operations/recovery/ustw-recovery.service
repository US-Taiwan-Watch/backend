[Unit]
Description=USTW encrypted media backup to private Azure storage
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=3600
ExecStart=/usr/bin/python3 /usr/local/lib/ustw-recovery/backup.py
