[Unit]
Description=USTW encrypted database and media backup to private Azure storage
After=network-online.target mongod.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=3600
ExecStartPre=/usr/local/sbin/ustw-mongodb-backup
ExecStart=/usr/bin/python3 /usr/local/lib/ustw-recovery/backup.py
